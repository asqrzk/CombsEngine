const Ticket = kind("what is the person writing in about", {
  refund: "the person wants money they paid returned",
  cancel: "the person wants their subscription ended now",
  other:  "none of these",
}, { fallback: "other" });
const Mood = scale("how does the person sound", ["furious", "annoyed", "neutral", "pleased"]);
settle({ floor: 0.55, gap: 0.4, confidence: 0.3 });

const ticket = decide({{input}}, Ticket);
switch (ticket.value) {
  case Ticket.refund:
    if (the {{input}} is at least annoyed on Mood) { log("refund, escalate") }
    else { log("refund, standard") }
    break;
  case "cancel":
    log("cancel flow");
    break;
  case unsure:
    log("could not tell:", ticket.reason);
    break;
  default:
    log("general inbox");
}
